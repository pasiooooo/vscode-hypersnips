{
	"name": "vscode-hypersnips",
	"displayName": "vscode-hypersnips",
	"description": "Programmable LaTeX snippets, smart alignment, and snippet management for VS Code.",
	"icon": "images/vscode-hypersnips.png",
	"version": "0.1.4",
	"publisher": "pasiooooo",
	"author": "pasiooooo",
	"homepage": "https://github.com/pasiooooo/vscode-hypersnips#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/pasiooooo/vscode-hypersnips"
	},
	"bugs": {
		"url": "https://github.com/pasiooooo/vscode-hypersnips/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Snippets",
		"Other"
	],
	"keywords": [
		"ultisnips",
		"programmable snippets",
		"dynamic snippets",
		"snippets"
	],
	"preview": true,
	"activationEvents": [
		"onStartupFinished",
		"onLanguage:hsnips",
		"onLanguage:markdown",
		"onLanguage:latex",
		"onLanguage:tex",
		"onCommand:hsnips.openSnippetsDir",
		"onCommand:hsnips.openSnippetFile",
		"onCommand:hsnips.openSnippetManager",
		"onCommand:hsnips.selectProfile",
		"onCommand:hsnips.openActiveProfile",
		"onCommand:hsnips.reloadSnippets",
		"onCommand:hsnips.convertEnvironment",
		"onCommand:hsnips.renameMatchingEnvironment",
		"onCommand:hsnips.wrapMathStructure",
		"onCommand:hsnips.unwrapMathStructure",
		"onCommand:hsnips.smartEnter",
		"onCommand:hsnips.smartTab",
		"onCommand:hsnips.matrixTab"
	],
	"contributes": {
		"configuration": [
			{
				"title": "vscode-hypersnips",
				"properties": {
					"hsnips.autoAlign.enabled": {
						"type": "boolean",
						"default": true,
						"scope": "language-overridable",
						"description": "Automatically align LaTeX columns, operators, row breaks, and comments after edits. Disable to keep manually entered spacing."
					},
					"hsnips.multiLineContext": {
						"type": "number",
						"default": 20,
						"description": "Number of lines matched when using multi-line regex mode."
					},
					"hsnips.windows": {
						"type": "string",
						"default": "%APPDATA%/Code/User/hsnips",
						"description": "Custom path for Windows."
					},
					"hsnips.linux": {
						"type": "string",
						"default": "$HOME/.config/Code/User/hsnips",
						"description": "Custom path for Linux."
					},
					"hsnips.mac": {
						"type": "string",
						"default": "$HOME/Library/Application Support/Code/User/hsnips",
						"description": "Custom path for Mac OS."
					},
					"hsnips.context.extraMathEnvironments": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional LaTeX environments treated as math contexts."
					},
					"hsnips.context.extraRowBreakEnvironments": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional LaTeX environments where Enter can append a row break."
					},
					"hsnips.context.extraAlignmentEnvironments": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional LaTeX environments where Tab can insert an alignment separator."
					},
					"hsnips.context.extraTextLikeCommands": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional LaTeX commands whose argument should be treated as text, not math."
					},
					"hsnips.profiles.activeProfile": {
						"type": "string",
						"default": "",
						"description": "Active snippet profile loaded from hsnips/profiles/<name>. Empty means base snippets only."
					}
				}
			}
		],
		"commands": [
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.openSnippetsDir",
				"title": "Open Snippets Directory"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.openSnippetFile",
				"title": "Open Snippet File"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.openSnippetManager",
				"title": "Open Snippet Manager"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.selectProfile",
				"title": "Select Snippet Profile"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.openActiveProfile",
				"title": "Open Active Snippet Profile"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.reloadSnippets",
				"title": "Reload Snippets"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.convertEnvironment",
				"title": "Convert LaTeX Environment"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.renameMatchingEnvironment",
				"title": "Rename Matching LaTeX Environment"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.wrapMathStructure",
				"title": "Wrap Math Structure"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.unwrapMathStructure",
				"title": "Unwrap Math Structure"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.smartEnter",
				"title": "Smart Math Enter"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.matrixTab",
				"title": "Insert Matrix Column Separator"
			},
			{
				"category": "vscode-hypersnips",
				"command": "hsnips.smartTab",
				"title": "Smart Alignment Tab"
			}
		],
		"keybindings": [
			{
				"key": "enter",
				"command": "hsnips.smartEnter",
				"when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && hsnips.canSmartEnter"
			},
			{
				"key": "tab",
				"command": "hsnips.smartTab",
				"when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && hsnips.canSmartTab"
			},
			{
				"key": "shift+tab",
				"command": "hsnips.prevPlaceholder",
				"when": "editorTextFocus && hasPrevTabstop && inSnippetMode"
			},
			{
				"key": "shift+escape",
				"command": "hsnips.leaveSnippet",
				"when": "editorTextFocus && inSnippetMode"
			},
			{
				"key": "escape",
				"command": "hsnips.leaveSnippet",
				"when": "editorTextFocus && inSnippetMode"
			}
		],
		"languages": [
			{
				"id": "hsnips",
				"extensions": [
					".hsnips"
				],
				"aliases": [
					"vscode-hypersnips"
				]
			}
		],
		"grammars": [
			{
				"language": "hsnips",
				"scopeName": "source.hsnips",
				"path": "./syntaxes/hsnips.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.js": "javascript"
				}
			}
		]
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run prepare-monaco && npm run compile",
		"prepare-monaco": "node scripts/prepare-monaco.js",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "tsc --noEmit -p ./",
		"test": "tsc -p tsconfig.test.json && node .test-out/test/index.js && node .test-out/test/incremental.js && node --expose-gc .test-out/test/incrementalMemory.js && node .test-out/test/alignmentPerformance.js && node .test-out/test/fontScheduling.js && node .test-out/test/snippetPerformance.js && node .test-out/test/snippetManager.js && node .test-out/test/completionPerformance.js && node .test-out/test/sanitizingPerformance.js && node test/releaseNotes.cjs",
		"check": "npm run lint && npm run test",
		"package": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/",
		"test:integration": "npm run compile && tsc -p tsconfig.test.json && node scripts/run-integration.cjs",
		"package:performance": "node scripts/package-performance.cjs",
		"release:notes": "node scripts/release-notes.cjs",
		"benchmark": "tsc -p tsconfig.test.json && node --expose-gc scripts/benchmark.cjs"
	},
	"devDependencies": {
		"@types/node": "18.19.130",
		"@types/vscode": "1.85.0",
		"@vscode/test-electron": "3.1.0",
		"@vscode/vsce": "4.0.0",
		"monaco-editor": "^0.52.2",
		"typescript": "5.4.5"
	}
}
